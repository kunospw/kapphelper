{
  "name": "kapphelper-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"server/test/*.test.mjs\"",
    "test:e2e": "node --env-file=.env.server server/test/e2e/roles.e2e.mjs",
    "preview": "vite preview",
    "server": "node --env-file=.env.server --env-file-if-exists=.env.plane server/src/index.js",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env.server node_modules/prisma/build/index.js migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "node --env-file=.env.server node_modules/prisma/build/index.js migrate deploy --schema server/prisma/schema.prisma",
    "add-dev-user": "node --env-file=.env.server scripts/add-dev-user.mjs",
    "set-access": "node --env-file=.env.server scripts/set-access.mjs",
    "sync:github": "node --env-file=.env.server --env-file=.env.sync scripts/sync-github.mjs",
    "sync:tsapp-git": "node --env-file=.env.server --env-file=.env.gitlog scripts/sync-local-git.mjs",
    "sync:plane": "node --env-file=.env.server --env-file=.env.plane scripts/sync-plane.mjs",
    "sync:captures": "node --env-file=.env.server scripts/sync-captures.mjs",
    "merge:activity": "node --env-file=.env.server scripts/merge-activity.mjs",
    "publish:portfolio": "node --env-file=.env.server scripts/publish-portfolio.mjs",
    "sync:all": "node scripts/sync-all.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@vitejs/plugin-react": "latest",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}
