# Backend (server/, scripts/) — never commit the real .env.server.
DATABASE_URL=postgresql://kapphelper:kapphelper@127.0.0.1:5433/kapphelper_dashboard
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=30
PORT=4175
CORS_ORIGIN=http://127.0.0.1:4174

# Background sync (server/src/sync-scheduler.js) — runs `npm run sync:all`
# once on server startup, then on this interval, for as long as the server
# process stays running. Set SYNC_DISABLED=true to turn it off entirely.
SYNC_INTERVAL_MINUTES=60
SYNC_DISABLED=false
