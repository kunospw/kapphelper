# Backend (server/, scripts/) — never commit the real .env.server.
DATABASE_URL=postgresql://kapphelper:kapphelper@127.0.0.1:5433/kapphelper_dashboard
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=30
PORT=4175
CORS_ORIGIN=http://127.0.0.1:4174

# Background sync (server/src/sync-scheduler.js) — runs `npm run sync:all`
# once on server startup, then on this interval, for as long as the server
# process stays running. Set SYNC_DISABLED=true to turn it off entirely.
SYNC_INTERVAL_MINUTES=60
SYNC_DISABLED=false

# Mark done -> Plane write-back (the ONLY Plane write the dashboard does; see docs).
# Off by default: without PLANE_WRITE_ENABLED=true, "Mark done" is recorded in the
# dashboard only and flagged "not synced to Plane". Needs PLANE_BASE_URL / PLANE_WORKSPACE /
# PLANE_PROJECT_ID from .env.plane (loaded automatically) and a Plane token file whose
# user is allowed to edit work items (PLANE_WRITE_TOKEN_PATH, default = the sync token path).
# Try DRY_RUN first: it resolves the endpoint and the "Done" state without changing Plane.
# PLANE_WRITE_ENABLED=false
# PLANE_WRITE_DRY_RUN=true

